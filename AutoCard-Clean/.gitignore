# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment variables (sensitive - never commit)
.env
.env.*
.env.local
.env.*.local
server/.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# EXCEPT example files (these are safe to commit)
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.kiro/
.kilo/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Prisma
server/node_modules/.prisma/
prisma/dev.db
prisma/prisma/dev.db

# Lock files (keep package-lock.json, ignore others if unused)
bun.lock
bun.lockb

# Misc
*.tsbuildinfo
.cache/

# Temporary files
*.tmp
*.temp

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Uploads (if any sensitive files)
backend/uploads/
uploads/

# Documentation to keep in repo (DO NOT IGNORE)
# All .md files should be committed
# !*.md
# !**/*.md
