// Prisma schema for Techware Automation INDIA
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum OnboardingStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  HOLIDAY
  PENDING_APPROVAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestType {
  ONBOARDING
  GENERAL
  DOCUMENT
  EQUIPMENT
  CORRECTION
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
}

// ===========================================================================
// AUTH & PROFILES
// ===========================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One-to-one role profiles.
  employeeProfile EmployeeProfile?
  customerProfile CustomerProfile?

  // Admin review activity.
  reviewedLeaveRequests LeaveRequest[]    @relation("LeaveReviewer")
  reviewedRequests      EmployeeRequest[] @relation("RequestReviewer")

  // Per-module permissions (EMPLOYEE role only).
  modulePermissions ModulePermission[]

  @@index([role])
  @@map("users")
}

model EmployeeProfile {
  id           String           @id @default(uuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String           @unique
  onboardingStatus OnboardingStatus @default(PENDING)

  // --- Personal details ---
  firstName       String?
  lastName        String?
  phone           String?
  alternatePhone  String?
  personalEmail   String?
  dateOfBirth     DateTime?
  gender          String?
  maritalStatus   String?
  nationality     String?
  bloodGroup      String?

  // Current + permanent address.
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?

  // --- Emergency contact ---
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // --- Banking details ---
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankBranch        String?

  // --- Professional details ---
  jobTitle          String?
  employmentType    EmploymentType?
  highestQualification String?
  university           String?
  graduationYear       Int?
  totalExperienceYears Float?
  previousemployer     String?
  skills               String?

  // --- Identification / proofs ---
  nationalIdNumber  String?
  taxIdNumber       String?
  passportNumber    String?
  // Uploaded document references (file names / URLs).
  idProofDocument        String?
  addressProofDocument   String?
  educationProofDocument String?
  resumeDocument         String?
  profileImage           String?  // Employee profile photo

  // --- Job assignment (admin-managed) ---
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  dateOfJoining    DateTime?

  // Default shift & location assignment.
  shiftId    String?
  shift      Shift?    @relation(fields: [shiftId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Reporting manager (self relation).
  managerId String?
  manager   EmployeeProfile?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   EmployeeProfile[] @relation("EmployeeManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations.
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  requests           EmployeeRequest[]
  rosterEntries      RosterEntry[]
  projectAssignments ProjectAssignment[]

  @@index([departmentId])
  @@map("employee_profiles")
}

model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  phone       String?
  address     String?
  city        String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A customer owns many projects.
  projects Project[]
  serviceRequests CustomerServiceRequest[]

  @@map("customer_profiles")
}

// ===========================================================================
// ORG STRUCTURE: DEPARTMENT, SHIFT, LOCATION
// ===========================================================================

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees EmployeeProfile[]

  @@map("departments")
}

model Shift {
  id          String   @id @default(uuid())
  name        String   @unique
  startTime   String // "HH:mm" 24-hour format
  endTime     String // "HH:mm" 24-hour format
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees     EmployeeProfile[]
  rosterEntries RosterEntry[]

  @@map("shifts")
}

model Location {
  id          String   @id @default(uuid())
  name        String   @unique
  addressLine String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  radius      Float?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees     EmployeeProfile[]
  rosterEntries RosterEntry[]

  @@map("locations")
}

// ===========================================================================
// ROSTER
// ===========================================================================

model RosterEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("roster_entries")
}

// ===========================================================================
// ATTENDANCE
// ===========================================================================

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  workedHours Float?
  note        String?          @db.Text
  checkInLatitude   Float?  // GPS latitude where employee checked in
  checkInLongitude  Float?  // GPS longitude where employee checked in
  checkOutLatitude  Float?  // GPS latitude where employee checked out
  checkOutLongitude Float?  // GPS longitude where employee checked out
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

// ===========================================================================
// LEAVE: POLICY (TYPES + BALANCES) AND REQUESTS
// ===========================================================================

model LeaveType {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  daysPerYear Int      @default(0)
  description String?
  isPaid      Boolean  @default(true)
  isActive    Boolean  @default(true)
  requiresApproval Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String          @id @default(uuid())
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allocated   Float           @default(0)
  used        Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String          @id @default(uuid())
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType       @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  totalDays   Float
  reason      String?
  status      LeaveStatus     @default(PENDING)

  // Admin review.
  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

// ===========================================================================
// HOLIDAYS
// ===========================================================================

enum HolidayType {
  NATIONAL
  FESTIVAL
  OPTIONAL
}

model Holiday {
  id          String      @id @default(uuid())
  name        String
  date        DateTime    @unique
  holidayType HolidayType @default(FESTIVAL)
  isOptional  Boolean     @default(false)
  description String?
  isRecurring Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([date])
  @@index([holidayType])
  @@map("holidays")
}

// ===========================================================================
// REQUESTS (ADMIN INBOX FOR NON-LEAVE EMPLOYEE REQUESTS)
// ===========================================================================

model EmployeeRequest {
  id          String          @id @default(uuid())
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        RequestType     @default(GENERAL)
  subject     String
  description String?
  status      RequestStatus   @default(PENDING)

  // Admin review.
  reviewedById String?
  reviewedBy   User?     @relation("RequestReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("employee_requests")
}

// ===========================================================================
// PROJECTS
// ===========================================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  progress    Int           @default(0) // 0-100
  startDate   DateTime?
  endDate     DateTime?
  isArchived  Boolean       @default(false)

  // Owning customer (optional — internal projects may have none).
  customerId String?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id])

  // Project manager (optional).
  managerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignments ProjectAssignment[]
  tasks       ProjectTask[]
  documents   ProjectDocument[]
  comments    ProjectComment[]
  activities  ProjectActivity[]

  @@index([customerId])
  @@index([status])
  @@index([isArchived])
  @@map("projects")
}

model ProjectAssignment {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnProject String?         // e.g., "Developer", "Designer", "Project Manager"
  assignedAt    DateTime        @default(now())

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_assignments")
}

model ProjectTask {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  
  // Assignment
  assignedToId String?
  dueDate      DateTime?
  completedAt  DateTime?
  
  // Task order within project
  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
  @@map("project_tasks")
}

model ProjectDocument {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?     // in bytes
  fileType    String?  // MIME type
  uploadedById String
  uploadedAt  DateTime @default(now())

  @@index([projectId])
  @@map("project_documents")
}

model ProjectComment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdAt])
  @@map("project_comments")
}

model ProjectActivity {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  activityType String  // e.g., "created", "status_changed", "member_added", "task_completed"
  description String   @db.Text
  metadata    String?  @db.Text // JSON string for additional data
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@map("project_activities")
}

// ===========================================================================
// ROLES & ACCESS (PER-ROLE, PER-MODULE PERMISSIONS)
// ===========================================================================

model AccessControl {
  id        String   @id @default(uuid())
  role      Role
  moduleKey String // matches the frontend module key, e.g. "attendance"
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, moduleKey])
  @@map("access_controls")
}

// ===========================================================================
// MODULE PERMISSIONS (PER-USER, PER-MODULE — for EMPLOYEE role)
// ===========================================================================

model ModulePermission {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
  @@map("module_permissions")
}

// ===========================================================================
// MISC (EXISTING)
// ===========================================================================

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

// ===========================================================================
// SERVICES
// ===========================================================================

model Service {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  features    String   @db.Text // JSON array stored as text
  price       String
  category    String?
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerRequests CustomerServiceRequest[]

  @@index([isActive])
  @@index([orderIndex])
  @@map("services")
}

model CustomerServiceRequest {
  id          String                @id @default(uuid())
  customerId  String
  customer    CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  subject     String
  description String                @db.Text
  priority    TaskPriority          @default(MEDIUM)
  status      CustomerRequestStatus @default(PENDING)
  response    String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("customer_service_requests")
}

// ===========================================================================
// SUPPORT
// ===========================================================================

model SupportInfo {
  id              String   @id @default(uuid())
  companyName     String
  supportEmail    String
  supportPhone    String
  liveChatEnabled Boolean  @default(false)
  liveChatUrl     String?
  supportHours    String   @db.Text // JSON object with day-wise hours
  faqs            String   @db.Text // JSON array of FAQ objects
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("support_info")
}
