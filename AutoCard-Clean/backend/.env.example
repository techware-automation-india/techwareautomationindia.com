# ==================== DATABASE ====================
DATABASE_URL="mysql://username:password@host:port/database_name"

# ==================== SERVER ====================
PORT=4000
NODE_ENV="development"

# ==================== CORS - ALLOWED ORIGINS ====================
# Comma-separated list of allowed frontend URLs
# For local: use http://localhost:5173
# For production: use your actual domain URLs
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

# Optional: Allow ALL Vercel preview deployments (*.vercel.app)
# Set to "true" to allow any *.vercel.app domain (useful for preview branches)
ALLOW_VERCEL_PREVIEWS="false"

# Optional: Allow ALL Hostinger sites (*.hostinger.site, *.hostingersite.com)
ALLOW_HOSTINGER_SITES="false"

# ==================== AUTHENTICATION ====================
JWT_SECRET="your_secret_key_here"
JWT_EXPIRES_IN="7d"

# ==================== EMAIL SERVICE ====================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="your_gmail_app_password"
EMAIL_TO=recipient@example.com
